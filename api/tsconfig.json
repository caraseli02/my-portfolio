{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@data/*": ["../src/data/*"],
      "@types/*": ["../src/types/*"]
    }
  },
  "include": ["./**/*.ts", "../src/data/**/*.ts", "../src/types/**/*.ts"]
}
